---
import { Image } from 'astro:assets';

interface Props {
  projects: any[];
  lang: 'es' | 'en';
}

const { projects, lang } = Astro.props;

const sectionTexts = {
  es: {
    title: 'Proyectos Destacados',
    subtitle: 'Soluciones técnicas reales y su impacto práctico.',
    roleLabel: 'Rol',
    clientLabel: 'Contexto',
    yearLabel: 'Año',
    viewDetails: 'Ver caso de estudio',
    githubRepo: 'Repositorio',
  },
  en: {
    title: 'Featured Projects',
    subtitle: 'Real-world technical solutions and their practical impact.',
    roleLabel: 'Role',
    clientLabel: 'Context',
    yearLabel: 'Year',
    viewDetails: 'View case study',
    githubRepo: 'Repository',
  },
}[lang];
---

<section id="proyectos" class="py-16 border-b border-zinc-200 dark:border-zinc-900 scroll-mt-20">
  <div class="space-y-2 mb-12">
    <h2 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      {sectionTexts.title}
    </h2>
    <p class="text-sm text-zinc-600 dark:text-zinc-400 max-w-lg">
      {sectionTexts.subtitle}
    </p>
  </div>

  <div class="space-y-12">
    {projects.map((project) => {
      // Calcular slug real (ej. "es/fts-tuning" -> "fts-tuning")
      const realSlug = project.id.split('/').slice(1).join('/');
      const detailUrl = `/${lang}/proyectos/${realSlug}`;
      
      return (
        <article class="group relative flex flex-col md:flex-row gap-8 rounded-2xl border border-zinc-200 dark:border-zinc-900 bg-white dark:bg-zinc-950 p-6 hover:border-zinc-300 dark:hover:border-zinc-800 hover:bg-zinc-50/50 dark:hover:bg-zinc-900/10 transition-all duration-300 shadow-sm hover:shadow-md dark:shadow-none">
          
          <!-- Image Section -->
          <div class="w-full md:w-[320px] h-[200px] flex-shrink-0 rounded-lg overflow-hidden bg-zinc-100 dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-900 relative">
            {project.data.coverImage ? (
              <Image
                src={project.data.coverImage}
                alt={project.data.title}
                width={320}
                height={200}
                class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center font-mono text-[10px] text-zinc-500 dark:text-zinc-600 bg-zinc-100 dark:bg-zinc-900">
                [ No Cover Image ]
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/40 to-transparent pointer-events-none"></div>
          </div>

          <!-- Content Section -->
          <div class="flex-grow flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <!-- Meta Tags (Client, Year) -->
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-zinc-500 dark:text-zinc-500">
                <span>{sectionTexts.clientLabel}: <strong class="text-zinc-700 dark:text-zinc-400">{project.data.client || 'N/A'}</strong></span>
                <span class="text-zinc-300 dark:text-zinc-800">•</span>
                <span>{sectionTexts.yearLabel}: <strong class="text-zinc-700 dark:text-zinc-400">{project.data.year}</strong></span>
              </div>

              <!-- Title & Role -->
              <div class="space-y-1">
                <h3 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-brand-emerald transition-colors">
                  {project.data.title}
                </h3>
                <p class="font-mono text-xs text-brand-cyan">
                  {sectionTexts.roleLabel}: {project.data.role}
                </p>
              </div>

              <!-- Summary -->
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed max-w-2xl">
                {project.data.summary}
              </p>
            </div>

            <!-- Tech Stack Tags -->
            <div class="space-y-4">
              <div class="flex flex-wrap gap-1.5">
                {project.data.stack.map((tech: string) => (
                  <span class="px-2 py-0.5 rounded border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-900/50 font-mono text-[10px] text-zinc-600 dark:text-zinc-400 hover:border-brand-emerald/30 hover:text-zinc-800 dark:hover:text-zinc-300 transition-colors">
                    {tech}
                  </span>
                ))}
              </div>

              <!-- Action Links -->
              <div class="flex flex-wrap items-center gap-6 pt-2 border-t border-zinc-200 dark:border-zinc-900/50">
                <a
                  href={detailUrl}
                  class="inline-flex items-center gap-1 text-xs font-mono text-brand-emerald hover:underline"
                >
                  {sectionTexts.viewDetails}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>

                {project.data.repoUrl && (
                  <a
                    href={project.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:text-zinc-500 dark:hover:text-zinc-300 transition-colors"
                  >
                    <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24">
                      <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                    </svg>
                    {sectionTexts.githubRepo}
                  </a>
                )}
              </div>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
