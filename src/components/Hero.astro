---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  subtitle: string;
  badgeText: string;
  lang: 'es' | 'en';
}

const { title, subtitle, badgeText, lang } = Astro.props;

const ctaTexts = {
  es: {
    contact: 'Hablemos',
    cv: 'Descargar CV',
  },
  en: {
    contact: 'Let\'s talk',
    cv: 'Download CV',
  },
}[lang];
---

<section class="relative py-12 md:py-20 flex flex-col md:flex-row items-center gap-12 border-b border-zinc-200 dark:border-zinc-900">
  <!-- Glowing Background Effect -->
  <div class="absolute -top-10 -left-10 h-72 w-72 rounded-full bg-brand-emerald/10 blur-[100px] pointer-events-none"></div>
  <div class="absolute top-20 right-10 h-72 w-72 rounded-full bg-brand-cyan/10 blur-[100px] pointer-events-none"></div>

  <!-- Left Column: Content -->
  <div class="flex-1 space-y-6 text-center md:text-left z-10">
    <!-- Availability Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-emerald-500/20 bg-emerald-500/5 font-mono text-xs text-brand-emerald">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-emerald"></span>
      </span>
      {badgeText}
    </div>

    <!-- Main Heading -->
    <div class="space-y-2">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight bg-gradient-to-r from-zinc-900 via-zinc-800 to-zinc-700 dark:from-zinc-100 dark:via-zinc-200 dark:to-zinc-400 bg-clip-text text-transparent">
        {title}
      </h1>
      <p class="font-mono text-xs sm:text-sm text-brand-cyan">
        [ ~/software-engineer-portfolio ]
      </p>
    </div>

    <!-- Subtitle / Value Prop -->
    <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-450 max-w-xl leading-relaxed">
      {subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 pt-2">
      <a
        href="#contacto"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-brand-emerald text-white font-semibold text-sm hover:bg-emerald-600 transition-all shadow-lg hover:shadow-emerald-500/10 focus-visible:ring-offset-2"
      >
        {ctaTexts.contact}
      </a>
      
      <a
        href="#sobre-mi"
        class="inline-flex items-center justify-center px-5 py-3 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-100/30 dark:bg-zinc-900/30 text-zinc-700 dark:text-zinc-300 font-semibold text-sm hover:border-zinc-350 dark:hover:border-zinc-700 hover:text-zinc-900 dark:hover:text-zinc-100 transition-all"
      >
        {lang === 'es' ? 'Sobre mí' : 'About me'}
      </a>
    </div>
  </div>

  <!-- Right Column: Premium Terminal Frame Image -->
  <div class="w-full max-w-xs sm:max-w-sm flex-shrink-0 z-10">
    <div class="relative rounded-2xl border border-zinc-200 dark:border-zinc-850 bg-white/40 dark:bg-zinc-900/40 p-2 shadow-2xl backdrop-blur-sm group">
      <!-- Terminal Bar -->
      <div class="flex items-center justify-between px-3 pb-2 pt-1 border-b border-zinc-200 dark:border-zinc-850">
        <div class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-red-500/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-yellow-500/70"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-green-500/70"></span>
        </div>
        <span class="font-mono text-[10px] text-zinc-500">santiago_bruno.jpg</span>
      </div>
      
      <!-- Image Wrapper with Glow -->
      <div class="relative overflow-hidden rounded-lg mt-2 bg-zinc-950 aspect-[3/4]">
        <Image
          src="/assets/hero.jpg"
          alt="Santiago Rafael Bruno"
          width={400}
          height={533}
          class="object-cover object-[80%_center] w-full h-full transition-all duration-700 ease-out scale-105 group-hover:scale-100"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-transparent to-transparent"></div>
        
        <!-- Interactive Terminal Tag -->
        <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between font-mono text-[10px] text-zinc-500 dark:text-zinc-400 bg-white/80 dark:bg-zinc-950/80 backdrop-blur-md px-3 py-1.5 rounded-md border border-zinc-200 dark:border-zinc-800">
          <span>LOC: ES / AR</span>
          <span class="text-brand-emerald">SYS: active</span>
        </div>
      </div>
    </div>
  </div>
</section>
