---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const esProjects = allProjects.filter((p) => p.id.startsWith('es/'));

  return esProjects.map((project) => {
    const realSlug = project.id.split('/').slice(1).join('/');
    return {
      params: { slug: realSlug },
      props: { project },
    };
  });
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} — Caso de Estudio`}
  description={project.data.summary}
  lang="es"
>
  <div class="space-y-8 py-6">
    <!-- Back Navigation -->
    <div>
      <a
        href="/es/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-zinc-500 hover:text-zinc-300 transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-3.5 w-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Volver al inicio
      </a>
    </div>

    <!-- Project Header -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs font-mono text-brand-cyan">
        <span>Cliente: <strong>{project.data.client || 'N/A'}</strong></span>
        <span>•</span>
        <span>Año: <strong>{project.data.year}</strong></span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-100">
        {project.data.title}
      </h1>
      <p class="font-mono text-sm text-zinc-400">
        Rol: {project.data.role}
      </p>
    </div>

    <!-- Cover Image -->
    {project.data.coverImage && (
      <div class="rounded-2xl border border-zinc-900 overflow-hidden bg-zinc-950 max-h-[480px]">
        <Image
          src={project.data.coverImage}
          alt={project.data.title}
          width={1024}
          height={480}
          class="w-full h-full object-cover max-h-[480px]"
          loading="eager"
        />
      </div>
    )}

    <!-- Split Content and Sidebar -->
    <div class="flex flex-col md:flex-row gap-12 pt-4">
      <!-- Main Case Study Content -->
      <article class="flex-grow max-w-3xl prose prose-invert prose-emerald text-zinc-300 space-y-6">
        <Content />
      </article>

      <!-- Sidebar: Meta Details -->
      <aside class="w-full md:w-[260px] flex-shrink-0 space-y-6">
        <!-- Tech Stack Panel -->
        <div class="rounded-xl border border-zinc-900 bg-zinc-950 p-5 space-y-4">
          <h3 class="font-mono text-xs font-semibold text-zinc-400 tracking-wider uppercase">
            Stack Tecnológico
          </h3>
          <div class="flex flex-wrap gap-1.5">
            {project.data.stack.map((tech: string) => (
              <span class="px-2.5 py-1 rounded bg-zinc-900 border border-zinc-850 font-mono text-xs text-zinc-300">
                {tech}
              </span>
            ))}
          </div>
        </div>

        <!-- Links Panel -->
        <div class="rounded-xl border border-zinc-900 bg-zinc-950 p-5 space-y-3">
          <h3 class="font-mono text-xs font-semibold text-zinc-400 tracking-wider uppercase mb-2">
            Recursos
          </h3>
          
          {project.data.repoUrl && (
            <a
              href={project.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 font-mono text-xs text-zinc-400 hover:text-brand-emerald transition-colors py-1.5"
            >
              <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              Repositorio de GitHub
            </a>
          )}

          {project.data.demoUrl && (
            <a
              href={project.data.demoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 font-mono text-xs text-zinc-400 hover:text-brand-emerald transition-colors py-1.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
              </svg>
              Ver Demo en Vivo
            </a>
          )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
